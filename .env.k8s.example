LLM_PROVIDER=codex
CODEX_TRANSPORT=http
# Adjust the namespace if Codex is installed elsewhere.
CODEX_REMOTE_URL=http://codex-gateway.codex.svc.cluster.local:8080
# Inject CODEX_REMOTE_TOKEN using secretKeyRef in the orchestrator's namespace.
CODEX_REMOTE_TOKEN=
CODEX_TIMEOUT_SECONDS=600
CODEX_REMOTE_TIMEOUT_SECONDS=630
